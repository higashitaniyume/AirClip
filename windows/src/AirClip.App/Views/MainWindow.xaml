<Window x:Class="AirClip.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirClip · 局域网剪贴板同步"
        Width="900" Height="640" MinWidth="760" MinHeight="500"
        Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Width="12" Height="12" CornerRadius="6" Margin="2,0,12,0"
              VerticalAlignment="Center">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Muted}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="Connected">
                <Setter Property="Background" Value="{StaticResource Brush.Good}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="Paused">
                <Setter Property="Background" Value="{StaticResource Brush.Warn}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Text.Title}" />
        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="立即发送剪贴板" Style="{StaticResource Button.Primary}"
                Command="{Binding SendClipboardCommand}" />
        <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}"
                Margin="8,0,0,0" MinWidth="92" />
      </StackPanel>
    </Grid>
    <TabControl x:Name="Tabs" Grid.Row="1">
      <TabItem Header="设备">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="本机" Style="{StaticResource Text.Section}" />
              <TextBlock Text="{Binding LocalEndpoint}" Style="{StaticResource Text.Mono}" />
              <!--
                Every Run binding below is explicitly OneWay: Run.Text binds two-way by default (it
                exists to be edited inside a RichTextBox), and a two-way bind to a get-only view-model
                property throws at template realisation rather than merely logging a binding error.
              -->
              <TextBlock Style="{StaticResource Text.Muted}" Margin="0,10,0,0"><Run Text="mDNS 服务：" /><Run Text="{Binding ServiceName, Mode=OneWay}" /></TextBlock>
              <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="配对指纹：" /><Run Text="{Binding PairingFingerprint, Mode=OneWay}" /><Run Text=" · 同一组设备的指纹必须相同；配对码本身在「设置」里查看，这里只显示它的摘要。" /></TextBlock>
            </StackPanel>
          </Border>

          <Grid Grid.Row="1" Margin="0,16,0,8">
            <TextBlock Text="已发现的设备" Style="{StaticResource Text.Section}" Margin="0"
                       VerticalAlignment="Center" />
            <Button Content="重新扫描" Style="{StaticResource Button.Small}" HorizontalAlignment="Right"
                    Command="{Binding RefreshPeersCommand}" />
          </Grid>

          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Peers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Brush.PanelAlt}" CornerRadius="8"
                              Padding="12,10" Margin="4">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Mono}" Margin="0,4,0,0"><Run Text="{Binding PlatformLabel, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Address, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DeviceId, Mode=OneWay}" /></TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding LatencyLabel}" Style="{StaticResource Text.Mono}"
                                       HorizontalAlignment="Right" Margin="0,4,0,0" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Text="尚未发现设备。请确认另一台设备与本机在同一局域网、使用相同的配对码，且防火墙没有拦截 AirClip。"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                         TextWrapping="Wrap" TextAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasPeers}" Value="False">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="历史">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="剪贴板历史（仅保存在内存中）" Style="{StaticResource Text.Section}"
                       Margin="0" VerticalAlignment="Center" />
            <Button Content="清空" Style="{StaticResource Button.Small}" HorizontalAlignment="Right"
                    Command="{Binding ClearHistoryCommand}" />
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding History}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource Brush.PanelAlt}" CornerRadius="8"
                              Padding="12,10" Margin="4">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Image Grid.Column="0" Source="{Binding Thumbnail}" MaxHeight="40" MaxWidth="72"
                                 Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image.Style>
                              <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Image.Style>
                          </Image>

                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Text.Mono}" Margin="0,4,0,0"><Run Text="{Binding TimeLabel, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding DirectionLabel, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding KindLabel, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding SizeLabel, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding HashLabel, Mode=OneWay}" /></TextBlock>
                          </StackPanel>

                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                      Margin="12,0,0,0">
                            <Button Content="复制" Style="{StaticResource Button.Small}"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.CopyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="发送" Style="{StaticResource Button.Small}" Margin="6,0,0,0"
                                    CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SendItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <TextBlock Text="复制任意文本或图片，它会立刻出现在这里。" HorizontalAlignment="Center"
                         VerticalAlignment="Center" Margin="24" TextAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding History.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="设置">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="同步行为" Style="{StaticResource Text.Section}" />
                <CheckBox Content="同步图片（CF_DIB / PNG）" IsChecked="{Binding SyncImages}" />
                <CheckBox Content="尊重敏感内容标记（密码管理器复制的内容不同步）"
                          IsChecked="{Binding HonorSensitiveMarkers}" />
                <CheckBox Content="保存本机历史" IsChecked="{Binding KeepHistory}" />
                <CheckBox Content="收到远端内容时弹出气泡提示" IsChecked="{Binding NotifyOnReceive}" />

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="文本上限（KB）" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding MaxTextKb}" Width="140"
                           HorizontalAlignment="Left" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="图片上限（KB）" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding MaxImageKb}" Width="140"
                           HorizontalAlignment="Left" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="历史保留条数" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding HistoryLimit}" Width="140"
                           HorizontalAlignment="Left" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="去抖动间隔（ms）" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding DebounceMs}" Width="140"
                           HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="去抖动间隔在监听器启动时读取，重启 AirClip 后生效。"
                           Style="{StaticResource Text.Muted}" Margin="160,6,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="身份与网络" Style="{StaticResource Text.Section}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="设备名称" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding DeviceName}" MaxWidth="320"
                           MinWidth="240" HorizontalAlignment="Left" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="mDNS 服务名" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding ServiceName}" MaxWidth="320"
                           MinWidth="240" HorizontalAlignment="Left" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="监听端口" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding ListenPort}" Width="140"
                           HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="服务名与端口在网络层启动时读取，改完后点下面的「重启网络」即可生效。"
                           Style="{StaticResource Text.Muted}" Margin="160,6,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="网络与配对" Style="{StaticResource Text.Section}" />
                <CheckBox Content="启用局域网同步（关闭后不监听端口，也不广播 mDNS）"
                          IsChecked="{Binding EnableSync}" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="配对指纹" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding PairingFingerprint}"
                             Style="{StaticResource Text.Mono}" VerticalAlignment="Center" />
                </Grid>

                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="配对码" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding PairingCodeDisplay}"
                             Style="{StaticResource Text.Mono}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{Binding PairingRevealLabel}" MinWidth="88"
                            Style="{StaticResource Button.Small}"
                            Command="{Binding TogglePairingRevealCommand}" />
                    <Button Content="复制" Style="{StaticResource Button.Small}" Margin="6,0,0,0"
                            Command="{Binding CopyPairingCommand}" />
                    <Button Content="重新生成" Style="{StaticResource Button.Small}" Margin="6,0,0,0"
                            Command="{Binding RegeneratePairingCommand}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="配对码是这一组设备的共享密钥，默认隐藏，所以窗口可以直接截图或投屏。复制时会打上「不进入剪贴板历史 / 不上传云剪贴板」标记。重新生成会让其他设备立刻掉线，需要重新配对。"
                           Style="{StaticResource Text.Muted}" Margin="160,6,0,0" TextWrapping="Wrap" />

                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="输入对方的配对码" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" MinWidth="240" Margin="0,0,12,0"
                           Text="{Binding PairingCodeInput, UpdateSourceTrigger=PropertyChanged}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="应用" Style="{StaticResource Button.Small}"
                            Command="{Binding ApplyPairingCommand}" />
                    <Button Content="重启网络" Style="{StaticResource Button.Small}" Margin="6,0,0,0"
                            Command="{Binding RestartNetworkCommand}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="可以粘贴 8 组 4 位的配对码，也可以粘贴手机扫码得到的 airclip:// 链接。两端配对码不一致时握手会被拒绝，设备列表里会写明原因。"
                           Style="{StaticResource Text.Muted}" Margin="160,6,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock Text="启动" Style="{StaticResource Text.Section}" />
                <CheckBox Content="开机自启（写入 HKCU\Run）" IsChecked="{Binding StartWithWindows}" />
                <CheckBox Content="启动时直接最小化到托盘" IsChecked="{Binding StartMinimised}" />
                <TextBlock Text="{Binding LogPath}" Style="{StaticResource Text.Mono}" Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,9" CornerRadius="8"
            Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Text.Muted}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="打开日志" Style="{StaticResource Button.Small}"
                  Command="{Binding OpenLogCommand}" />
          <Button Content="配置目录" Style="{StaticResource Button.Small}" Margin="6,0,0,0"
                  Command="{Binding OpenSettingsFolderCommand}" />
          <Button Content="隐藏到托盘" Style="{StaticResource Button.Small}" Margin="6,0,0,0"
                  Click="OnHideToTray" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
