<?xml version="1.0" encoding="utf-8"?>
<!-- Images put on the clipboard must be handed out as content URIs; the pasting app is granted
     read access by ClipboardService on our behalf, which only works for a grantUriPermissions
     provider like this one. -->
<paths>
    <cache-path
        name="clips"
        path="clips/" />
    <!-- 诊断日志 leaves the app through a share sheet, which needs a URI rather than a string:
         a full buffer is well over the transaction limit for EXTRA_TEXT. -->
    <cache-path
        name="logs"
        path="logs/" />
</paths>
